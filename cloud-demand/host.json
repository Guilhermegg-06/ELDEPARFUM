{
  "version": "2.0",
  "functionTimeout": "00:00:30",
  "extensions": {
    "http": {
      "routePrefix": "api",
      "maxOutstandingRequests": 50,
      "maxConcurrentRequests": 10
    }
  },
  "logging": {
    "logLevel": {
      "default": "Warning",
      "Function": "Information"
    },
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": true,
        "maxTelemetryItemsPerSecond": 1
      },
      "enableLiveMetricsFilters": true
    },
    "fileLoggingMode": "always"
  }
}
